# PostgreSQL and Docker Compose
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=
POSTGRES_DB=agentflow
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8501
DATABASE_URL=

# Redis-backed distributed API rate limiting
# Redis counters are ephemeral; no persistent volume is required.
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=
REDIS_MAX_CONNECTIONS=20
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1

# Use a secret-manager-generated value of at least 16 characters.
# This key pseudonymizes authenticated principal subjects in Redis keys.
RATE_LIMIT_KEY_HMAC_SECRET=
RATE_LIMIT_ENABLED=true

# Standard API bucket: burst of 60, refilling at 1 request per second.
RATE_LIMIT_STANDARD_CAPACITY=60
RATE_LIMIT_STANDARD_REFILL_RATE_PER_SECOND=1

# Expensive workflows: burst of 5, refilling at 1 request every 10 seconds.
RATE_LIMIT_EXPENSIVE_CAPACITY=5
RATE_LIMIT_EXPENSIVE_REFILL_RATE_PER_SECOND=0.1

# Production HTTP boundary
# JSON arrays are required for list settings.
# Replace api.agentflow.example.com with the real deployed API hostname.
TRUSTED_HOSTS=["127.0.0.1","backend","api.agentflow.example.com"]
CORS_ALLOWED_ORIGINS=[]
MAX_REQUEST_BODY_BYTES=1048576

# JWT authentication
# Production Docker Compose requires authentication to be enabled.
AUTH_ENABLED=true
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=agentflow-api
# Supply the identity provider's PEM public key through a secret manager.
AUTH_JWT_PUBLIC_KEY=

# Anthropic integration
ANTHROPIC_ENABLED=false
AGENT_DYNAMIC_PLANNING_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_MAX_RETRIES=2

# Independent dynamic-agent cost controls
# Blank model values fall back to ANTHROPIC_MODEL.
AGENT_DYNAMIC_PLANNER_MODEL=
AGENT_DYNAMIC_PLANNER_MAX_TOKENS=1024
AGENT_DYNAMIC_SYNTHESIS_MODEL=
AGENT_DYNAMIC_SYNTHESIS_MAX_TOKENS=2048

# Pricing is configuration-driven to avoid stale vendor rates.
AGENT_DYNAMIC_PLANNER_INPUT_COST_PER_MILLION_USD=0
AGENT_DYNAMIC_PLANNER_OUTPUT_COST_PER_MILLION_USD=0
AGENT_DYNAMIC_SYNTHESIS_INPUT_COST_PER_MILLION_USD=0
AGENT_DYNAMIC_SYNTHESIS_OUTPUT_COST_PER_MILLION_USD=0
# Leave blank to disable the fail-closed per-request ceiling.
AGENT_DYNAMIC_MAX_ESTIMATED_COST_USD=

# Slack approved-alert delivery
# Use a Slack bot token from a secret manager. Never commit the real token.
SLACK_BOT_TOKEN=
# Use the target Slack channel ID, not the channel display name.
SLACK_CHANNEL_ID=

# OpenTelemetry tracing and metrics
# Set these to the collector's signal-specific OTLP HTTP endpoints.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentflow-ai-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=1

# Metrics use a separate /v1/metrics endpoint.
OTEL_METRICS_ENABLED=false
OTEL_METRICS_EXPORTER_OTLP_ENDPOINT=
# Valid range: 1000–300000 milliseconds.
OTEL_METRICS_EXPORT_INTERVAL_MILLISECONDS=60000
